module d_ff (
    input  wire clk,
    input  wire D,
    output reg  Q,
    output wire Q_bar
);
    always @(posedge clk) begin
        Q <= D;
    end

    assign Q_bar = ~Q;
endmodule


//  D Flip-Flop with Synchronous Reset (Active High) 
module d_ff_sync_reset (
    input  wire clk,
    input  wire rst,
    input  wire D,
    output reg  Q,
    output wire Q_bar
);
    always @(posedge clk) begin
        if (rst)
            Q <= 1'b0;
        else
            Q <= D;
    end

    assign Q_bar = ~Q;
endmodule


//  D Flip-Flop with Asynchronous Reset (Active High) 
module d_ff_async_reset (
    input  wire clk,
    input  wire rst,
    input  wire D,
    output reg  Q,
    output wire Q_bar
);
    always @(posedge clk or posedge rst) begin
        if (rst)
            Q <= 1'b0;
        else
            Q <= D;
    end

    assign Q_bar = ~Q;
endmodule


//  N-bit D Register 
module d_register #(
    parameter WIDTH = 18
)(
    input  wire             clk,
    input  wire             rst,
    input  wire             en,
    input  wire [WIDTH-1:0] D,
    output reg  [WIDTH-1:0] Q
);
    always @(posedge clk or posedge rst) begin
        if (rst)
            Q <= {WIDTH{1'b0}};
        else if (en)
            Q <= D;
    end
endmodule



