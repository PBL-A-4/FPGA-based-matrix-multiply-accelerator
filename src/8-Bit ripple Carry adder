module full_adder (
    input  wire a,
    input  wire b,
    input  wire cin,
    output wire sum,
    output wire cout
);
    assign sum  = a ^ b ^ cin;
    assign cout = (a & b) | (b & cin) | (a & cin);
endmodule

// 18-bit Ripple Carry Adder
module ripple_carry_adder_18bit (
    input  wire [17:0] A,
    input  wire [17:0] B,
    input  wire        Cin,
    output wire [17:0] Sum,
    output wire        Cout,
    output wire        Overflow
);
    wire [18:0] carry;
    assign carry[0] = Cin;
 
    genvar i;
    generate
        for (i = 0; i < 18; i = i + 1) begin : rca_chain
            full_adder fa (
                .a   (A[i]),
                .b   (B[i]),
                .cin (carry[i]),
                .sum (Sum[i]),
                .cout(carry[i+1])
            );
        end
    endgenerate
 
    assign Cout     = carry[18];
    assign Overflow = carry[17] ^ carry[18];
endmodule

